<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.InternConnect" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

    <!--    Dark Mode-->
    <style name="SCREEN">
        <item name="android:background">@color/dark_back</item>
    </style>

    <style name="TEXT">
        <item name="android:textColor">#FFF</item>
    </style>

    <style name="SUB_TEXT">
        <item name="android:textColor">#999999</item>
    </style>

    <style name="BUTTTON">
        <item name="android:backgroundTint">@color/violoet</item>
        <item name="android:textColor">#FFF</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="ITEM_BACK">
        <item name="cardBackgroundColor">@color/item_back</item>
    </style>

    <style name="ITEM_TEXT">
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="ITEM_SUB_TEXT">
        <item name="android:textColor">#C1C1C1</item>
    </style>
    <style name="ITEM_SAL_TEXT">
        <item name="android:textColor">@color/violoet</item>
    </style>
    <style name="ITEM_RED_BUTTON">
        <item name="android:backgroundTint">@color/item_red</item>
        <item name="android:textColor">#FFF</item>
        <item name="cornerRadius">10dp</item>
    </style>

</resources>